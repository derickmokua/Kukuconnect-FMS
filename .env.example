# Copy to .env.local (and Vercel Production env) for v1 live.
# Without Supabase vars, the app runs localStorage-only (single device).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Canonical site URL (metadata / sharing)
NEXT_PUBLIC_SITE_URL=https://kukuconnect.co.ke

# REQUIRED for v1 — real till or paybill (shown on /order)
NEXT_PUBLIC_MPESA_TILL=123456

# Staff phone for new-order SMS alerts + "Message KukuConnect" WhatsApp (2547…)
NEXT_PUBLIC_STAFF_PHONE=2547XXXXXXXX

# Africa's Talking SMS (server-only — never expose API key to the browser)
# Sandbox: username=sandbox  |  Live: your AT username
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_FROM=

# Farm assistant AI (SpaceXAI / xAI — server only, never NEXT_PUBLIC_)
# Get a key: https://console.x.ai
XAI_API_KEY=
# Optional model override (default grok-4.5)
# XAI_MODEL=grok-4.5
